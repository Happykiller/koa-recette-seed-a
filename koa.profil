{
  // Seed de recette de KoA (plan 112, R1) : jetable. Un agent qui ne fait rien de coûteux.
  "version": 1,
  "nom": "koa-recette-a",
  "utilisateur": "agent",
  "paquets": ["make", "python3"],
  "bootstrap": "bootstrap.sh",
  "repertoire": "~/profile",
  "agent": {
    "nature": "claude",
    "mode": "bypassPermissions",
    "modele": "haiku",
    "consigne": "Lis CLAUDE.md, puis fais ce qu'il demande."
  },
  "secrets": {
    "RECETTE": { "requis": true }
  }
}
